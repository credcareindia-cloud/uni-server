// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // URL-friendly identifier
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users         User[]
  projects      Project[]
  notifications Notification[]
  estimates     Estimate[]
  rateCards     RateCard[]
  quoteRequests QuoteRequest[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           UserRole @default(ADMIN)
  permissions    String[] @default([])
  organizationId String   @map("organization_id")
  createdBy      String?  @map("created_by")
  avatar         String?
  phone          String?
  location       String?
  company        String?
  userRole       String?  @map("user_role")
  lastLogin      DateTime? @map("last_login")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator                User?            @relation("UserCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers           User[]           @relation("UserCreator")
  projects               Project[]
  notifications          Notification[]
  sessions               Session[]
  statusHistory          StatusHistory[]
  panelStatusAssignments PanelStatus[]
  panelGroupAssignments  PanelGroup[]
  projectMemberships     ProjectMember[]
  panelViews             UserPanelView[]
  uploadedDocuments      ProjectDocument[] @relation("UserUploadedDocuments")
  estimates              Estimate[]
  rateCards              RateCard[]
  quoteRequests          QuoteRequest[] @relation("QuoteCreatedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id             Int           @id @default(autoincrement())
  displayNumber  Int           @map("display_number")
  name           String
  description    String?
  status         ProjectStatus @default(PLANNING)
  stage          ProjectStage  @default(PROJECT)
  buildSystem    BuildSystem   @default(LGS) @map("build_system")
  createdBy      String        @map("created_by")
  organizationId String        @map("organization_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Current active model (one-to-one relationship)
  currentModelId String? @unique @map("current_model_id")

  // Metadata
  metadata Json? // Flexible project metadata

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User           @relation(fields: [createdBy], references: [id])
  currentModel  Model?         @relation("ProjectCurrentModel", fields: [currentModelId], references: [id])
  modelHistory  Model[]        @relation("ProjectModelHistory")
  groups        Group[]
  panels        Panel[]        // Panels in this project
  statuses      Status[]       // Custom statuses for this project
  members       ProjectMember[] // Project members and roles
  documents     ProjectDocument[] // Project-level documents (PDFs, drawings, etc.)
  browserRevisions ProjectBrowserRevision[]
  drawings         ProjectDrawing[]
  estimates        Estimate[]
  quoteRequests    QuoteRequest[]

  @@unique([organizationId, displayNumber])
  @@index([organizationId])
  @@map("projects")
}

/// Revit Project Browser snapshot for one publish revision (multiFileJobId)
model ProjectBrowserRevision {
  id           String   @id @default(cuid())
  projectId    Int      @map("project_id")
  publishJobId String   @unique @map("publish_job_id")
  snapshot     Json
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_browser_revisions")
}

enum DrawingKind {
  VIEW
  SHEET
}

/// CAD drawing (DXF/DWG) exported from Revit for a publish revision
model ProjectDrawing {
  id              String      @id @default(cuid())
  projectId       Int         @map("project_id")
  publishJobId    String      @map("publish_job_id")
  stableKey       String      @map("stable_key")
  kind            DrawingKind
  name            String
  sheetNumber     String?     @map("sheet_number")
  viewType        String?     @map("view_type")
  revitElementId  Int?        @map("revit_element_id")
  dxfStorageKey   String?     @map("dxf_storage_key")
  dwgStorageKey   String?     @map("dwg_storage_key")
  sizeBytes       BigInt      @default(0) @map("size_bytes")
  createdAt       DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([publishJobId, stableKey])
  @@index([projectId])
  @@index([publishJobId])
  @@map("project_drawings")
}

model ProjectDocument {
  id               String           @id @default(cuid())
  projectId        Int              @map("project_id")
  category         DocumentCategory @default(DRAWINGS)
  name             String           // User-supplied display name
  originalFilename String           @map("original_filename")
  storageKey       String           @map("storage_key") // S3/MinIO object key
  mimeType         String           @map("mime_type")
  sizeBytes        BigInt           @map("size_bytes")
  uploadedBy       String?          @map("uploaded_by") // User id who uploaded
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User?   @relation("UserUploadedDocuments", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, category])
  @@index([uploadedBy])
  @@map("project_documents")
}

model Model {
  id               String      @id @default(cuid())
  projectId        Int         @map("project_id")
  originalFilename String      @map("original_filename")
  storageKey       String      @map("storage_key") // S3/MinIO object key
  type             ModelType   @default(FRAG)
  sizeBytes        BigInt      @map("size_bytes")
  status           ModelStatus @default(READY) // FRAG files are instantly ready for viewing!
  
  // Multi-file project support
  category         ModelCategory @default(OTHER) // Building component category
  displayName      String?       @map("display_name") // User-friendly name for the component
  isMultiFile      Boolean       @default(false) @map("is_multi_file") // Part of multi-file project
  multiFileJobId   String?       @map("multi_file_job_id") // Reference to multi-file processing job
  fileIndex        Int?          @map("file_index") // Order within multi-file project
  
  // Version information
  version          Int         @default(1) // Model version number
  isActive         Boolean     @default(true) @map("is_active") // Is this the current active version?
  replacedById     String?     @unique @map("replaced_by_id") // ID of the model that replaced this one
  
  // FRAG files don't need processing - they're ready immediately!
  processingProgress Int?    @default(100) @map("processing_progress") // Always 100% for FRAG
  errorMessage      String? @map("error_message")
  
  // FRAG Metadata (for 3D viewer integration)
  elementCount     Int?  @map("element_count") // Can be extracted from FRAG if needed
  spatialStructure Json? @map("spatial_structure") // Building hierarchy from FRAG
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project         Project        @relation("ProjectModelHistory", fields: [projectId], references: [id], onDelete: Cascade)
  currentProject  Project?       @relation("ProjectCurrentModel") // If this is the current active model
  replacedBy      Model?         @relation("ModelReplacement", fields: [replacedById], references: [id])
  replaces        Model?         @relation("ModelReplacement")
  elements        ModelElement[]
  panels          Panel[]        // Panels linked to this model

  @@map("models")
}

model ModelElement {
  id        String @id @default(cuid())
  modelId   String @map("model_id")
  expressId Int    @map("express_id") // IFC Express ID
  globalId  String @map("global_id")  // IFC GlobalId
  ifcType   String @map("ifc_type")   // IfcWall, IfcDoor, etc.
  
  // Spatial context
  storey String? // Building storey
  space  String? // Space/room
  
  // Geometry (bounding box)
  bbox Json? // {min: [x,y,z], max: [x,y,z]}
  
  // Properties (flexible JSONB for all IFC properties)
  properties Json? // All Psets, Qtos, and basic properties
  
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  model  Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  panels Panel[] // Panels linked to this element

  @@unique([modelId, expressId])
  @@index([modelId, globalId])
  @@index([modelId, ifcType])
  @@index([modelId, storey])
  @@map("model_elements")
}

model Group {
  id          String      @id @default(cuid())
  projectId   Int         @map("project_id")
  name        String
  description String?
  status      GroupStatus @default(PENDING)
  color       String      @default("#3B82F6") // Group color for visual distinction
  
  // Group metadata
  elementIds Json? @map("element_ids") // Array of element IDs in this group
  metadata   Json? // Flexible group metadata
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  panelGroups PanelGroup[] // Many-to-many relation

  @@index([projectId])
  @@map("groups")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId Int         @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// Panel Management Models
model Panel {
  id          String      @id @default(cuid())
  projectId   Int         @map("project_id")
  modelId     String?     @map("model_id") // Optional link to model
  elementId   String?     @map("element_id") // Optional link to model element
  
  // Panel identification
  name        String      // Panel name/identifier
  tag         String?     // Panel tag/code
  objectType  String?     @map("object_type") // Type of panel (Concrete, Steel, etc.)

  // Fabrication route: decides CNC rollforming vs casting, and whether members collapse
  componentType ComponentType? @map("component_type")
  
  // Panel properties
  dimensions  String?     // Panel dimensions
  location    String?     // Panel location
  material    String?     // Panel material
  weight      Float?      // Panel weight
  area        Float?      // Panel area
  
  // Multi-status and multi-group assignment (no single status/group anymore)
  // Legacy fields removed - all panels use many-to-many relations
  
  // Manufacturing and logistics
  productionDate    DateTime? @map("production_date")
  shippingDate      DateTime? @map("shipping_date")
  installationDate  DateTime? @map("installation_date")
  
  // Additional metadata
  notes       String?     // Panel notes
  metadata    Json?       // Flexible panel metadata
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  model         Model?        @relation(fields: [modelId], references: [id], onDelete: SetNull)
  element       ModelElement? @relation(fields: [elementId], references: [id], onDelete: SetNull)
  statuses      PanelStatus[] // Many-to-many: Multiple statuses per panel
  groups        PanelGroup[]  // Many-to-many: Multiple groups per panel
  statusHistory StatusHistory[]
  
  @@index([projectId])
  @@index([modelId])
  @@map("panels")
}

model Status {
  id          String   @id @default(cuid())
  projectId   Int      @map("project_id")
  name        String
  icon        String   @default("circle")
  color       String   @default("#3B82F6")
  description String?
  order       Int      @default(0)
  isDefault   Boolean  @default(false) @map("is_default") // Mark prebuilt statuses
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  panelStatuses PanelStatus[] // Many-to-many relation

  @@index([projectId])
  @@index([projectId, order])
  @@map("statuses")
}

// Junction table for many-to-many relationship between Panels and Statuses
model PanelStatus {
  id         String   @id @default(cuid())
  panelId    String   @map("panel_id")
  statusId   String   @map("status_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") // User who assigned the status

  // Relations
  panel  Panel  @relation(fields: [panelId], references: [id], onDelete: Cascade)
  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [assignedBy], references: [id])

  @@unique([panelId, statusId]) // Prevent duplicate assignments
  @@index([panelId])
  @@index([statusId])
  @@map("panel_statuses")
}

// Junction table for many-to-many relationship between Panels and Groups
model PanelGroup {
  id         String   @id @default(cuid())
  panelId    String   @map("panel_id")
  groupId    String   @map("group_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") // User who assigned the group

  // Relations
  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [assignedBy], references: [id])

  @@unique([panelId, groupId]) // Prevent duplicate assignments
  @@index([panelId])
  @@index([groupId])
  @@map("panel_groups")
}

model StatusHistory {
  id        String   @id @default(cuid())
  panelId   String   @map("panel_id")
  statusId  String   @map("status_id")
  action    String   // "ASSIGNED" or "REMOVED"
  notes     String?  // Notes about status change
  changedBy String?  @map("changed_by") // User who changed the status
  
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changedBy], references: [id])

  @@index([panelId])
  @@index([statusId])
  @@map("status_history")
}

model Notification {
  id              String                 @id @default(cuid())
  userId          String                 @map("user_id")
  organizationId  String                 @map("organization_id")
  type            NotificationType
  title           String
  message         String
  read            Boolean                @default(false)
  status          NotificationStatus     @default(PENDING) @map("status")
  recipientRole   NotificationRole       @default(ADMIN) @map("recipient_role")
  
  // Optional metadata
  metadata Json? // Additional notification data
  
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

// QR Code Management Models
model QRCode {
  id         String    @id @default(cuid())
  panelId    String    @map("panel_id")
  projectId  Int       @map("project_id")
  
  // QR Code lifecycle
  isActive   Boolean   @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at") // Optional expiration
  scanCount  Int       @default(0) @map("scan_count")
  
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  scans QRScan[]

  @@unique([panelId]) // One QR code per panel
  @@index([projectId])
  @@index([isActive])
  @@map("qr_codes")
}

model QRScan {
  id         String   @id @default(cuid())
  qrCodeId   String   @map("qr_code_id")
  
  // Scan metadata
  scannedAt  DateTime @default(now()) @map("scanned_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")

  // Relations
  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([scannedAt])
  @@map("qr_scans")
}

// Track which submissions each user has viewed for notification badges
model UserPanelView {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  panelId           String   @map("panel_id")
  lastViewedAt      DateTime @default(now()) @map("last_viewed_at")
  lastViewedCount   Int      @default(0) @map("last_viewed_count") 
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, panelId])
  @@index([userId])
  @@index([panelId])
  @@map("user_panel_views")
}

// Track async project deletion jobs
model ProjectDeletion {
  id          String              @id @default(cuid())
  projectId   Int                 @map("project_id")
  projectName String              @map("project_name")
  status      ProjectDeletionStatus @default(PENDING)
  progress    Int                 @default(0) // 0-100
  message     String?             // Current operation message
  error       String?             // Error message if failed
  deletedBy   String              @map("deleted_by") // User ID who initiated deletion
  
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  completedAt DateTime?           @map("completed_at")

  @@index([projectId])
  @@index([status])
  @@index([deletedBy])
  @@map("project_deletions")
}


// Enums
enum UserRole {
  VIEWER
  MANAGER
  DESIGNER
  ESTIMATOR
  LOGISTICS
  PRODUCTION
  ADMIN
}

enum ProjectRole {
  OWNER
  MANAGER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// How far a job has progressed commercially, which decides what the project can hold.
///
/// A TENDER is being priced and has no model yet, so the delivery side of the project —
/// panels, sequencing, CNC — is not reachable. Winning the work promotes it to PROJECT,
/// which unlocks model upload. Promotion is one-way.
enum ProjectStage {
  TENDER
  PROJECT
}

enum QuoteSource {
  WEB
  MANUAL
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  STARTED
}

/// A public or staff quote: drawings, a note, and an optional IFC, before it becomes a tender.
model QuoteRequest {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  name           String
  email          String
  projectName    String      @map("project_name")
  note           String      @default("")
  drawingKey     String?     @map("drawing_key")
  drawingName    String?     @map("drawing_name")
  modelKey       String?     @map("model_key")
  modelName      String?     @map("model_name")
  source         QuoteSource @default(WEB)
  status         QuoteStatus @default(NEW)
  projectId      Int?        @map("project_id")
  estimateId     String?     @map("estimate_id")
  createdById    String?     @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@map("quote_requests")
}

enum ModelType {
  FRAG 
}

/// Primary structural system. HYBRID covers precast shells with LGS infill walls and pods.
enum BuildSystem {
  LGS
  PRECAST
  HYBRID
}

/// Per-panel fabrication route. LGS_* are rollformed and assembled from members;
/// PRECAST_* and POD are cast or factory-built as single units.
enum ComponentType {
  LGS_WALL_LB
  LGS_WALL_NLB
  LGS_FLOOR_TRUSS
  LGS_ROOF_TRUSS
  PRECAST_WALL
  PRECAST_FOOTING
  HOLLOWCORE_SLAB
  TIE_BEAM
  LEVELING_PAD
  POD
  CONNECTOR
  OTHER
}

enum ModelCategory {
  STRUCTURE   
  MEP         
  ELECTRICAL
  ARCHITECTURE
  OTHER       
}

enum ModelStatus {
  PROCESSING
  READY
  FAILED
}

enum GroupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum NotificationType {
  SYSTEM
  PROJECT_UPDATE
  MODEL_PROCESSED
  GROUP_STATUS_CHANGE
  USER_MENTION
}

enum NotificationRole {
  ADMIN
  MANAGER
  VIEWER
  BOTH
  ALL
}

enum NotificationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ProjectDeletionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DocumentCategory {
  DRAWINGS
  LOGISTICS
  CNC
}

enum EstimateStatus {
  DRAFT
  ISSUED
  WON
  LOST
  SUPERSEDED
}

/// How a line earns its sell rate. PASS_THROUGH covers preliminaries and logistics,
/// which carry no overhead, margin, financing or contingency.
enum PricingMode {
  FULL
  PASS_THROUGH
}

/// Where a takeoff quantity came from, so automation accuracy can be measured later.
enum TakeoffSource {
  MANUAL
  DRAWING
  BIM_MODEL
}

/// A priced revision of a job. Exists before a Project does: a tender is estimated,
/// and only once it is won does `projectId` get set, linking the baseline budget to
/// the delivery data without copying or migrating anything.
model Estimate {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  projectId      Int?           @map("project_id")

  /// The company job number, e.g. 5345. Shared by every revision of the same job.
  jobNumber      String         @map("job_number")
  /// Revision label as the estimators write it, e.g. "R0", "R2 -PRE WAR".
  revision       String
  name           String
  client         String?
  location       String?
  consultant     String?
  status         EstimateStatus @default(DRAFT)

  currency       String         @default("AED")
  /// Units of `currency` per USD, for the USD/sqft figure on the summary.
  fxRate         Float          @default(3.67) @map("fx_rate")
  totalArea      Float?         @map("total_area")

  // Commercial uplifts, stored per revision so an old quote stays reproducible
  // even after procurement republishes rates or management changes the margin.
  overheadPct     Float @default(0.15) @map("overhead_pct")
  marginPct       Float @default(0.15) @map("margin_pct")
  financingPct    Float @default(0.02) @map("financing_pct")
  contingencyPct  Float @default(0.05) @map("contingency_pct")
  customsPct      Float @default(0)    @map("customs_pct")
  corporateTaxPct Float @default(0)    @map("corporate_tax_pct")
  designPct       Float @default(0.02) @map("design_pct")
  commissionPct   Float @default(0.07) @map("commission_pct")

  /// Grand total at last save. Derived, kept so lists need not price every line.
  totalAmount    Float?   @map("total_amount")

  sourceFile     String?  @map("source_file")
  notes          String?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner        User           @relation(fields: [createdBy], references: [id])
  lines        EstimateLine[]
  takeoff      TakeoffItem[]

  @@unique([organizationId, jobNumber, revision])
  @@index([organizationId])
  @@index([projectId])
  @@map("estimates")
}

/// One priced line. Direct costs are snapshotted onto the row rather than referenced
/// from a live rate card, so republishing rates never alters an issued quote.
model EstimateLine {
  id         String  @id @default(cuid())
  estimateId String  @map("estimate_id")

  /// Position in the estimator's numbering, e.g. "3.4.10".
  slNo        String?
  /// Bill this line rolls into on the client summary, e.g. "Roofing".
  bill        String
  description String
  unit        String?
  sortOrder   Int     @default(0) @map("sort_order")

  qty         Float       @default(0)
  mode        PricingMode @default(FULL)

  // Direct cost components, per unit, in the estimate's currency.
  materialCost     Float @default(0) @map("material_cost")
  fabricationCost  Float @default(0) @map("fabrication_cost")
  installationCost Float @default(0) @map("installation_cost")
  prelimsCost      Float @default(0) @map("prelims_cost")
  shippingCost     Float @default(0) @map("shipping_cost")
  packagingCost    Float @default(0) @map("packaging_cost")
  loadingCost      Float @default(0) @map("loading_cost")

  /// Derived sell rate and amount at last save, for fast reads.
  sellRate    Float? @map("sell_rate")
  totalAmount Float? @map("total_amount")

  /// Set when the quantity came from a takeoff row rather than being typed in.
  takeoffItemId String? @map("takeoff_item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estimate Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  takeoff  TakeoffItem? @relation(fields: [takeoffItemId], references: [id], onDelete: SetNull)

  @@index([estimateId])
  @@map("estimate_lines")
}

/// A measured quantity from the drawings or the model, feeding one or more lines.
model TakeoffItem {
  id         String @id @default(cuid())
  estimateId String @map("estimate_id")

  storey      String?
  description String
  width       Float?
  height      Float?
  area        Float?
  totalArea   Float?        @map("total_area")
  totalSqft   Float?        @map("total_sqft")
  source      TakeoffSource @default(MANUAL)
  /// Element ids, drawing region or sheet the measurement came from.
  sourceRef   String?       @map("source_ref")
  sortOrder   Int           @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estimate Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lines    EstimateLine[]

  @@index([estimateId])
  @@map("takeoff_items")
}

/// A published set of rates. Owned by procurement; estimators consume but never edit.
/// Superseding a card leaves issued estimates untouched because they hold snapshots.
model RateCard {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  version        Int      @default(1)
  currency       String   @default("AED")
  effectiveFrom  DateTime @default(now()) @map("effective_from")
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [createdBy], references: [id])
  items        RateItem[]

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@map("rate_cards")
}

model RateItem {
  id         String @id @default(cuid())
  rateCardId String @map("rate_card_id")

  description   String
  unit          String?
  /// Supply rate per unit.
  unitRate      Float?  @map("unit_rate")
  /// Same rate converted to a per-sqft basis, as the estimators' data sheet keeps it.
  sqftRate      Float?  @map("sqft_rate")
  labourPerSqft Float?  @map("labour_per_sqft")
  supplier      String?
  notes         String?
  sortOrder     Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId])
  @@map("rate_items")
}